// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin") // admin, staff
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IPhoneUnit {
  id            Int       @id @default(autoincrement())
  model         String    // e.g., "iPhone 15 Pro Max"
  capacity      String    // e.g., "256GB"
  color         String    // e.g., "Natural Titanium"
  imei          String    @unique
  purchasePrice Float     // harga beli satuan
  sellingPrice  Float?    // harga jual (set when sold)
  quantity      Int       @default(1) // sisa unit tersedia
  status        String    @default("available") // available, sold
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  purchase      Purchase?
  sales         Sale[]
}

model Purchase {
  id            Int        @id @default(autoincrement())
  iphoneUnitId  Int        @unique
  iphoneUnit    IPhoneUnit @relation(fields: [iphoneUnitId], references: [id], onDelete: Cascade)
  quantity      Int        @default(1) // jumlah unit yang dibeli
  supplier      String?
  purchaseDate  DateTime   @default(now())
  notes         String?
  createdAt     DateTime   @default(now())
}

model Sale {
  id              Int              @id @default(autoincrement())
  iphoneUnitId    Int
  iphoneUnit      IPhoneUnit       @relation(fields: [iphoneUnitId], references: [id], onDelete: Cascade)
  quantity        Int              @default(1) // jumlah unit yang dijual
  sellingPrice    Float            // total harga jual deal
  buyerName       String?
  buyerPhone      String?
  saleDate        DateTime         @default(now())
  notes           String?
  additionalCosts AdditionalCost[]
  createdAt       DateTime         @default(now())
}

model AdditionalCost {
  id          Int      @id @default(autoincrement())
  saleId      Int?
  sale        Sale?    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  category    String   // Ongkir, Servis, Operasional, shipping, service, operational
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}
